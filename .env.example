# Шаблон .env для docker-compose.yml. На VDS .env пишет deploy workflow из секретов/переменных окружения GitHub,
# для локального запуска: cp .env.example .env
COMPOSE_PROJECT_NAME=smart-factoring-test

# теги образов ghcr.io/monbar921/smart-factoring-{backend,gateway}: short sha коммита или имя ветки (test, main)
BACKEND_TAG=test
BACKEND_PORT=8080
BACKEND_CPUS=1
BACKEND_MEM_LIMIT=1g

GATEWAY_TAG=test
GATEWAY_PORT=8090
GATEWAY_CPUS=0.5
GATEWAY_MEM_LIMIT=512m

POSTGRES_DB=smart_factoring
POSTGRES_USER=smart_factoring
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_CPUS=1
POSTGRES_MEM_LIMIT=512m
