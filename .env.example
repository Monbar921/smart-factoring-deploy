# Шаблон .env для docker-compose.yml. На VDS .env пишет deploy workflow из секретов/переменных окружения GitHub,
# для локального запуска: cp .env.example .env
COMPOSE_PROJECT_NAME=smart-factoring-test

# теги образов ghcr.io/monbar921/smart-factoring-{backend,gateway,ui,ml}: short sha коммита или имя ветки (test, main)
BACKEND_TAG=test
# порт, который слушает backend внутри сети compose (наружу не публикуется)
BACKEND_PORT=8080
BACKEND_CPUS=1
BACKEND_MEM_LIMIT=1g

GATEWAY_TAG=test
# порт, который слушает gateway и который открыт наружу на VDS
GATEWAY_PORT=8090
GATEWAY_CPUS=0.5
GATEWAY_MEM_LIMIT=512m

UI_TAG=test
# порт, который слушает nginx UI и который открыт наружу на VDS
UI_PORT=8070
UI_CPUS=0.25
UI_MEM_LIMIT=128m

# сервис моделей (PD и задержка оплаты), наружу не публикуется
ML_TAG=test
# http - backend ходит в сервис ml, stub - встроенная заглушка моделей backend
ML_MODE=http
ML_CPUS=1
ML_MEM_LIMIT=512m
# процессов uvicorn
ML_WORKERS=1

# realm стенда в общем keycloak: iss токенов = KEYCLOAK_PUBLIC_URL/realms/KEYCLOAK_REALM
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=smart-factoring-test

# база и пользователь стенда в общем postgres (создаются вручную, см. README.md)
POSTGRES_DB=smart_factoring_test
POSTGRES_USER=smart_factoring_test
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=smart_factoring_test

# LLM backend: stub - шаблонные тексты без LLM, gigachat - GigaChat API, off - без черновика сообщения клиенту
LLM_MODE=stub
# одновременных запросов к GigaChat, не больше лимита тарифа (Freemium - 1 поток)
LLM_PARALLELISM=8
# поле model запроса: GigaChat-2 (базовая), GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Lightning, GigaChat-3-Pro, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_API_PERS, GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# ключ авторизации из личного кабинета GigaChat API, нужен только при LLM_MODE=gigachat
GIGACHAT_AUTH_KEY=
