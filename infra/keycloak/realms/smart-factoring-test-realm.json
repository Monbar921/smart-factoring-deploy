{
  "realm": "smart-factoring-test",
  "displayName": "smart-factoring (test)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Пользователь smart-factoring"
      },
      {
        "name": "operator",
        "description": "Экран процесса: загрузка данных и запуск анализа дебиторки"
      },
      {
        "name": "manager",
        "description": "Эмулятор CRM: свои клиенты (атрибут manager_code, manager-setup.sh) и решения по предложениям"
      },
      {
        "name": "supervisor",
        "description": "Руководитель: эмулятор CRM по всем менеджерам и прогоны, только просмотр"
      }
    ]
  },
  "clients": [
    {
      "clientId": "smart-factoring-swagger",
      "name": "Swagger UI gateway",
      "description": "Кнопка Authorize в Swagger UI gateway: Authorization Code + PKCE. Для curl - ещё и password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_TEST_GATEWAY_URL}/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "manager-codes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "manager_code",
            "claim.name": "manager_codes",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "smart-factoring-ui",
      "name": "smart-factoring-ui",
      "description": "Вход пользователя в UI: Authorization Code + PKCE. localhost:5173 - npm run dev против стенда test.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${KEYCLOAK_TEST_UI_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${KEYCLOAK_TEST_UI_URL}/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "manager-codes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "manager_code",
            "claim.name": "manager_codes",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "${KEYCLOAK_TEST_USER}",
      "enabled": true,
      "email": "${KEYCLOAK_TEST_USER}@smart-factoring.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ]
}
