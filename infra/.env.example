# Шаблон .env для infra/docker-compose.yml. На VDS .env пишет workflow infra.yml из секретов/переменных репозитория,
# для локального запуска: cp infra/.env.example infra/.env
# суперпользователь postgres: создаётся только при первом запуске пустого volume
POSTGRES_USER_ADMIN=postgres
POSTGRES_PASSWORD_ADMIN=change-me-admin
# порт postgres на 127.0.0.1 VDS для ssh-туннеля
POSTGRES_PORT=5432
POSTGRES_CPUS=1
POSTGRES_MEM_LIMIT=512m
