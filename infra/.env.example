# Шаблон .env для infra/docker-compose.yml. На VDS .env пишет workflow infra.yml из секретов/переменных репозитория,
# для локального запуска: cp infra/.env.example infra/.env
# суперпользователь postgres: создаётся только при первом запуске пустого volume
POSTGRES_USER_ADMIN=postgres
POSTGRES_PASSWORD_ADMIN=change-me-admin
# порт postgres на 127.0.0.1 VDS для ssh-туннеля
POSTGRES_PORT=5432
POSTGRES_CPUS=1
POSTGRES_MEM_LIMIT=512m

# keycloak: администратор master realm создаётся только при первом старте на пустой базе
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# пароль пользователя keycloak в postgres (база keycloak создаётся workflow infra.yml, локально - init-db.sql вручную)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_PORT=8180
# публичный адрес keycloak: из него строятся страница логина и iss токенов
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_CPUS=1
KEYCLOAK_MEM_LIMIT=1g
# пользователь realm smart-factoring-test и адрес gateway test для redirect Swagger UI
KEYCLOAK_TEST_USER=tester
KEYCLOAK_TEST_USER_PASSWORD=change-me-tester
KEYCLOAK_TEST_GATEWAY_URL=http://localhost:8090
